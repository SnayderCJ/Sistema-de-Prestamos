{
    "name": "imaxprestamos/api",
    "description": "ImaxPrestamos - API REST para Sistema de Gestión de Préstamos",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "controllers/",
            "Services\\": "services/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}

