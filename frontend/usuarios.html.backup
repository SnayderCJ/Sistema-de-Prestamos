<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
                <a href="rutas.html">Rutas</a>
                <a href="pagos.html">Pagos</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html"><span class="icon">📊</span> Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html"><span class="icon">💵</span> Préstamos</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html"><span class="icon">👥</span> Clientes</a>
                </div>
                <div class="sidebar-menu-title">Configuración</div>
                <div class="sidebar-menu-item">
                    <a href="tasas.html"><span class="icon">📊</span> Tasas</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="usuarios.html" class="active"><span class="icon">👤</span> Usuarios</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="usuarios">
                <div class="usuarios-header">
                    <h1>Gestión de Usuarios</h1>
                    <button class="btn btn-primary" onclick="abrirModalCrear()">➕ Nuevo Usuario</button>
                </div>

                <div class="usuarios-filters">
                    <div class="form-group">
                        <label class="form-label">Rol</label>
                        <select class="form-control" id="filtroRol" onchange="filtrarUsuarios()">
                            <option value="">Todos</option>
                            <option value="admin">Admin</option>
                            <option value="supervisor">Supervisor</option>
                            <option value="analista">Analista</option>
                            <option value="cobrador">Cobrador</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Buscar</label>
                        <input type="text" class="form-control" id="buscarUsuario" placeholder="Cédula, nombre o email" onkeyup="filtrarUsuarios()">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Cédula</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Rol</th>
                                <th>Sucursal</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyUsuarios">
                            <tr><td colspan="8" class="text-center"><div class="loading"><div class="loading-spinner"></div></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Crear/Editar Usuario -->
    <div class="modal" id="modalCrearUsuario">
        <div class="modal-backdrop" onclick="cerrarModalCrear()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title" id="modalUsuarioTitulo">Nuevo Usuario</h3>
                <button class="modal-close" onclick="cerrarModalCrear()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formCrearUsuario">
                    <div class="form-group">
                        <label class="form-label">Cédula *</label>
                        <input type="text" class="form-control" id="cedula" maxlength="11" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Nombre *</label>
                            <input type="text" class="form-control" id="nombre" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Apellido *</label>
                            <input type="text" class="form-control" id="apellido" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" id="email" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Teléfono</label>
                        <input type="text" class="form-control" id="telefono">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Rol *</label>
                            <select class="form-control" id="rol" required>
                                <option value="">Seleccionar...</option>
                                <option value="admin">Admin</option>
                                <option value="supervisor">Supervisor</option>
                                <option value="analista">Analista</option>
                                <option value="cobrador">Cobrador</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sucursal</label>
                            <select class="form-control" id="sucursalId">
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Contraseña <span id="passwordRequired">*</span></label>
                        <input type="password" class="form-control" id="password" minlength="6">
                        <small class="form-text">Mínimo 6 caracteres</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select class="form-control" id="activo">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModalCrear()">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarUsuario()">Guardar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/usuarios.js"></script>
</body>
</html>


