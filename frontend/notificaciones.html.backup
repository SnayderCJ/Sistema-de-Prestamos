<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notificaciones - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
                <a href="notificaciones.html" class="active">Notificaciones</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">
                        <span class="icon">📊</span>
                        Dashboard
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="notificaciones.html" class="active">
                        <span class="icon">🔔</span>
                        Notificaciones
                        <span class="badge" id="badgeNotificaciones">0</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="page-header">
                <h1>Notificaciones</h1>
                <div class="page-actions">
                    <button class="btn btn-secondary" onclick="marcarTodasLeidas()">Marcar todas como leídas</button>
                    <button class="btn btn-primary" onclick="cargarNotificaciones()">Actualizar</button>
                </div>
            </div>

            <!-- Filtros -->
            <div class="filters-bar">
                <select id="filtroTipo" class="form-control" onchange="cargarNotificaciones()">
                    <option value="">Todos los tipos</option>
                    <option value="info">Información</option>
                    <option value="success">Éxito</option>
                    <option value="warning">Advertencia</option>
                    <option value="error">Error</option>
                    <option value="alert">Alerta</option>
                </select>
                <select id="filtroLeida" class="form-control" onchange="cargarNotificaciones()">
                    <option value="">Todas</option>
                    <option value="0">No leídas</option>
                    <option value="1">Leídas</option>
                </select>
            </div>

            <!-- Lista de Notificaciones -->
            <div class="notificaciones-container">
                <div id="loadingNotificaciones" class="loading" style="display: none;">
                    <div class="spinner"></div>
                    <p>Cargando notificaciones...</p>
                </div>
                <div id="listaNotificaciones" class="notificaciones-list">
                    <!-- Se llena dinámicamente -->
                </div>
                <div id="sinNotificaciones" class="empty-state" style="display: none;">
                    <p>No hay notificaciones</p>
                </div>
            </div>

            <!-- Paginación -->
            <div class="pagination" id="paginacion" style="display: none;">
                <!-- Se llena dinámicamente -->
            </div>
        </main>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/notificaciones.js"></script>
</body>
</html>

