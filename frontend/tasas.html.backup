<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasas de Interés - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
                <a href="rutas.html">Rutas</a>
                <a href="pagos.html">Pagos</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html"><span class="icon">📊</span> Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html"><span class="icon">💵</span> Préstamos</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html"><span class="icon">👥</span> Clientes</a>
                </div>
                <div class="sidebar-menu-title">Operaciones</div>
                <div class="sidebar-menu-item">
                    <a href="rutas.html"><span class="icon">🗺️</span> Rutas</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="pagos.html"><span class="icon">💳</span> Pagos</a>
                </div>
                <div class="sidebar-menu-title">Configuración</div>
                <div class="sidebar-menu-item">
                    <a href="tasas.html" class="active"><span class="icon">📊</span> Tasas</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="tasas">
                <div class="tasas-header">
                    <h1>Gestión de Tasas de Interés</h1>
                    <button class="btn btn-primary" onclick="abrirModalCrear()">➕ Nueva Tasa</button>
                </div>

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Tasa Mensual</th>
                                <th>Tasa Anual</th>
                                <th>Monto Mín</th>
                                <th>Monto Máx</th>
                                <th>Plazo Mín</th>
                                <th>Plazo Máx</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTasas">
                            <tr><td colspan="11" class="text-center"><div class="loading"><div class="loading-spinner"></div></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Crear/Editar Tasa -->
    <div class="modal" id="modalCrearTasa">
        <div class="modal-backdrop" onclick="cerrarModalCrear()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title" id="modalTasaTitulo">Nueva Tasa de Interés</h3>
                <button class="modal-close" onclick="cerrarModalCrear()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formCrearTasa">
                    <div class="form-group">
                        <label class="form-label">Código *</label>
                        <input type="text" class="form-control" id="codigo" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nombre *</label>
                        <input type="text" class="form-control" id="nombre" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tipo de Tasa *</label>
                        <select class="form-control" id="tipoTasa" required>
                            <option value="fija">Fija</option>
                            <option value="variable">Variable</option>
                            <option value="mixta">Mixta</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Tasa Mensual (%) *</label>
                            <input type="number" class="form-control" id="tasaMensual" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Tasa Anual (%) *</label>
                            <input type="number" class="form-control" id="tasaAnual" step="0.01" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Monto Mínimo (RD$)</label>
                            <input type="number" class="form-control" id="montoMinimo" step="0.01">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Monto Máximo (RD$)</label>
                            <input type="number" class="form-control" id="montoMaximo" step="0.01">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Plazo Mínimo (meses)</label>
                            <input type="number" class="form-control" id="plazoMinimo">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Plazo Máximo (meses)</label>
                            <input type="number" class="form-control" id="plazoMaximo">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select class="form-control" id="activa">
                            <option value="1">Activa</option>
                            <option value="0">Inactiva</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="descripcion" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModalCrear()">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarTasa()">Guardar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/tasas.js"></script>
</body>
</html>


