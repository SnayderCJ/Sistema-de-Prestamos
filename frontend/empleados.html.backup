<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Empleados - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="nomina.html">Nómina</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="nomina.html">💰 Nómina</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Empleados</h1>
                <button class="btn btn-primary" onclick="abrirModalEmpleado()">Nuevo Empleado</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Listado de Empleados</h2>
                    <input type="text" class="form-control" id="buscarEmpleado" placeholder="Buscar..." onkeyup="filtrarEmpleados()">
                </div>
                <div class="table-responsive">
                    <table class="table" id="tablaEmpleados">
                        <thead>
                            <tr>
                                <th>Cédula</th>
                                <th>Nombre</th>
                                <th>Departamento</th>
                                <th>Cargo</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="7" class="text-center">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Empleado -->
    <div class="modal" id="modalEmpleado">
        <div class="modal-backdrop" onclick="cerrarModalEmpleado()"></div>
        <div class="modal-dialog modal-lg">
            <div class="modal-header">
                <h3 id="tituloModalEmpleado">Nuevo Empleado</h3>
                <button class="modal-close" onclick="cerrarModalEmpleado()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formEmpleado" onsubmit="guardarEmpleado(event)">
                    <input type="hidden" id="empleadoId">
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Cédula *</label>
                            <input type="text" class="form-control" id="cedulaEmpleado" required>
                        </div>
                        <div class="form-group">
                            <label>NSS</label>
                            <input type="text" class="form-control" id="nssEmpleado">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Nombre *</label>
                            <input type="text" class="form-control" id="nombreEmpleado" required>
                        </div>
                        <div class="form-group">
                            <label>Apellido *</label>
                            <input type="text" class="form-control" id="apellidoEmpleado" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Departamento *</label>
                            <select class="form-control" id="departamentoEmpleado" required>
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Cargo *</label>
                            <input type="text" class="form-control" id="cargoEmpleado" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Teléfono</label>
                            <input type="text" class="form-control" id="telefonoEmpleado">
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" class="form-control" id="emailEmpleado">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Fecha Ingreso *</label>
                            <input type="date" class="form-control" id="fechaIngreso" required>
                        </div>
                        <div class="form-group">
                            <label>Salario Base</label>
                            <input type="number" class="form-control" id="salarioBase" step="0.01">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Dirección</label>
                        <textarea class="form-control" id="direccionEmpleado" rows="2"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModalEmpleado()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/empleados.js"></script>
</body>
</html>

