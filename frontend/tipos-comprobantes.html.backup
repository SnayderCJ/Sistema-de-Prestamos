<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tipos de Comprobantes - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="comprobantes-fiscales.html">Comprobantes</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="comprobantes-fiscales.html">🧾 Comprobantes</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Tipos de Comprobantes Fiscales</h1>
                <button class="btn btn-primary" onclick="abrirModalTipo()">Nuevo Tipo</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Listado de Tipos</h2>
                </div>
                <div class="table-responsive">
                    <table class="table" id="tablaTipos">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5" class="text-center">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Tipo -->
    <div class="modal" id="modalTipo">
        <div class="modal-backdrop" onclick="cerrarModalTipo()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 id="tituloModalTipo">Nuevo Tipo de Comprobante</h3>
                <button class="modal-close" onclick="cerrarModalTipo()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formTipo" onsubmit="guardarTipo(event)">
                    <input type="hidden" id="tipoId">
                    
                    <div class="form-group">
                        <label>Código *</label>
                        <input type="text" class="form-control" id="codigoTipo" maxlength="2" required>
                        <small>Código según DGII (01, 02, 03, etc.)</small>
                    </div>

                    <div class="form-group">
                        <label>Nombre *</label>
                        <input type="text" class="form-control" id="nombreTipo" required>
                    </div>

                    <div class="form-group">
                        <label>Descripción</label>
                        <textarea class="form-control" id="descripcionTipo" rows="3"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModalTipo()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/tipos-comprobantes.js"></script>
</body>
</html>

