<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprobantes Fiscales (NCF) - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="comprobantes-fiscales.html" class="active">NCF</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html"><span class="icon">📊</span> Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html"><span class="icon">💵</span> Préstamos</a>
                </div>
                
                <div class="sidebar-menu-title">Fiscal</div>
                <div class="sidebar-menu-item">
                    <a href="comprobantes-fiscales.html" class="active"><span class="icon">🧾</span> Comprobantes (NCF)</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="contabilidad.html"><span class="icon">📊</span> Contabilidad</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="reportes-dgii.html"><span class="icon">📋</span> Reportes DGII</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Comprobantes Fiscales (NCF)</h1>
                <button class="btn btn-primary" onclick="generarNCF()">
                    <span class="icon">➕</span> Generar NCF
                </button>
            </div>

            <!-- Filtros -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="filters">
                        <select id="filtroTipo" class="form-control form-control-sm">
                            <option value="">Todos los tipos</option>
                        </select>
                        <input type="text" id="filtroNCF" class="form-control form-control-sm" placeholder="Número NCF">
                        <input type="date" id="fechaDesde" class="form-control form-control-sm">
                        <input type="date" id="fechaHasta" class="form-control form-control-sm">
                        <select id="filtroEstado" class="form-control form-control-sm">
                            <option value="">Todos</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="emitido">Emitido</option>
                            <option value="anulado">Anulado</option>
                        </select>
                        <button class="btn btn-secondary btn-sm" onclick="filtrarComprobantes()">Filtrar</button>
                    </div>
                </div>
            </div>

            <!-- Lista de Comprobantes -->
            <div class="card">
                <div class="card-header">
                    <h2>Comprobantes Fiscales</h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>NCF</th>
                                    <th>Tipo</th>
                                    <th>Cliente</th>
                                    <th>Fecha Emisión</th>
                                    <th>Subtotal</th>
                                    <th>Impuestos</th>
                                    <th>Total</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaComprobantes">
                                <tr>
                                    <td colspan="9" class="text-center">Cargando...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Generar NCF -->
    <div id="modalNCF" class="modal" style="display: none;">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2>Generar Comprobante Fiscal (NCF)</h2>
                <button class="modal-close" onclick="cerrarModal('modalNCF')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formNCF">
                    <div class="form-group">
                        <label>Tipo de Comprobante *</label>
                        <select class="form-control" id="tipoComprobanteId" required onchange="cargarImpuestos()">
                            <option value="">Seleccionar tipo</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Cliente *</label>
                        <select class="form-control" id="clienteId" required onchange="cargarDatosCliente()">
                            <option value="">Seleccionar cliente</option>
                        </select>
                    </div>
                    <div id="datosCliente" style="display: none;">
                        <div class="grid grid-2">
                            <div class="form-group">
                                <label>RNC</label>
                                <input type="text" class="form-control" id="rncCliente">
                            </div>
                            <div class="form-group">
                                <label>Razón Social</label>
                                <input type="text" class="form-control" id="razonSocial">
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Relacionado con</label>
                        <select class="form-control" id="relacionadoCon" onchange="cargarRelacionado()">
                            <option value="">Ninguno</option>
                            <option value="prestamo">Préstamo</option>
                            <option value="pago">Pago</option>
                        </select>
                    </div>
                    <div id="relacionadoPrestamo" style="display: none;">
                        <div class="form-group">
                            <label>Préstamo</label>
                            <select class="form-control" id="prestamoId">
                                <option value="">Seleccionar préstamo</option>
                            </select>
                        </div>
                    </div>
                    <div id="relacionadoPago" style="display: none;">
                        <div class="form-group">
                            <label>Pago</label>
                            <select class="form-control" id="pagoId">
                                <option value="">Seleccionar pago</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Monto Subtotal (RD$) *</label>
                        <input type="number" step="0.01" class="form-control" id="montoSubtotal" required onchange="calcularTotal()">
                    </div>
                    <div class="form-group">
                        <label>Impuestos (Opcionales)</label>
                        <div id="impuestosContainer">
                            <!-- Los impuestos se cargarán dinámicamente -->
                        </div>
                        <small class="form-text text-muted">Seleccione los impuestos a aplicar</small>
                    </div>
                    <div class="form-group">
                        <label>Total (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="montoTotal" readonly>
                    </div>
                    <div class="form-group">
                        <label>Fecha de Emisión</label>
                        <input type="date" class="form-control" id="fechaEmision" value="">
                    </div>
                    <div class="form-group">
                        <label>Observaciones</label>
                        <textarea class="form-control" id="observaciones" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalNCF')">Cancelar</button>
                <button class="btn btn-primary" onclick="confirmarGenerarNCF()">Generar NCF</button>
            </div>
        </div>
    </div>

    <!-- Modal Detalle NCF -->
    <div id="modalDetalleNCF" class="modal" style="display: none;">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2>Detalle de Comprobante Fiscal #<span id="detalleNCFId"></span></h2>
                <button class="modal-close" onclick="cerrarModal('modalDetalleNCF')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid grid-2">
                    <div>
                        <h3>Información General</h3>
                        <table class="table">
                            <tr>
                                <th>ID:</th>
                                <td><span id="detalleNCFId">-</span></td>
                            </tr>
                            <tr>
                                <th>Número NCF:</th>
                                <td id="detalleNCFNumero">-</td>
                            </tr>
                            <tr>
                                <th>Tipo:</th>
                                <td id="detalleNCFTipo">-</td>
                            </tr>
                            <tr>
                                <th>Fecha:</th>
                                <td id="detalleNCFFecha">-</td>
                            </tr>
                            <tr>
                                <th>Estado:</th>
                                <td><span id="detalleNCFEstado" class="badge">-</span></td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h3>Información del Cliente</h3>
                        <table class="table">
                            <tr>
                                <th>Cliente:</th>
                                <td id="detalleNCFCliente">-</td>
                            </tr>
                            <tr>
                                <th>RNC:</th>
                                <td id="detalleNCFRNC">-</td>
                            </tr>
                            <tr>
                                <th>Razón Social:</th>
                                <td id="detalleNCFRazonSocial">-</td>
                            </tr>
                            <tr>
                                <th>Relacionado con:</th>
                                <td>
                                    <span id="detalleNCFPrestamo">-</span><br>
                                    <span id="detalleNCFPago">-</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <h3>Montos</h3>
                    <table class="table">
                        <tr>
                            <th>Subtotal:</th>
                            <td id="detalleNCFSubtotal">-</td>
                        </tr>
                        <tr>
                            <th>Impuestos:</th>
                            <td id="detalleNCFImpuestos">-</td>
                        </tr>
                        <tr>
                            <th>Total:</th>
                            <td><strong id="detalleNCFTotal">-</strong></td>
                        </tr>
                    </table>
                </div>
                <div class="mt-3">
                    <h3>Desglose de Impuestos</h3>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Impuesto</th>
                                <th>Porcentaje</th>
                                <th>Monto</th>
                            </tr>
                        </thead>
                        <tbody id="detalleNCFImpuestosLista">
                            <tr><td colspan="3" class="text-center">No hay impuestos</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <h3>Observaciones</h3>
                    <p id="detalleNCFObservaciones">-</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalDetalleNCF')">Cerrar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/comprobantes-fiscales.js"></script>
</body>
</html>

