<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Caja - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
                <a href="rutas.html">Rutas</a>
                <a href="pagos.html">Pagos</a>
                <a href="caja.html" class="active">Caja</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html"><span class="icon">📊</span> Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html"><span class="icon">💵</span> Préstamos</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html"><span class="icon">👥</span> Clientes</a>
                </div>
                
                <div class="sidebar-menu-title">Operaciones</div>
                <div class="sidebar-menu-item">
                    <a href="rutas.html"><span class="icon">🗺️</span> Rutas</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="pagos.html"><span class="icon">💳</span> Pagos</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="caja.html" class="active"><span class="icon">💰</span> Caja</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="desembolsos.html"><span class="icon">💸</span> Desembolsos</a>
                </div>
                
                <div class="sidebar-menu-title">Configuración</div>
                <div class="sidebar-menu-item">
                    <a href="tasas.html"><span class="icon">📊</span> Tasas</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Gestión de Caja</h1>
                <button class="btn btn-primary" onclick="abrirCaja()" id="btnAbrirCaja">
                    <span class="icon">➕</span> Abrir Caja
                </button>
            </div>

            <!-- Estado de Caja Actual -->
            <div class="card" id="estadoCaja" style="display: none;">
                <div class="card-header">
                    <h2>Caja Abierta</h2>
                    <button class="btn btn-danger btn-sm" onclick="cerrarCaja()">Cerrar Caja</button>
                </div>
                <div class="card-body">
                    <div class="grid grid-4">
                        <div class="stat-card">
                            <div class="stat-label">Monto Inicial</div>
                            <div class="stat-value" id="montoInicial">RD$ 0.00</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Efectivo</div>
                            <div class="stat-value" id="montoEfectivo">RD$ 0.00</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Cheques</div>
                            <div class="stat-value" id="montoCheques">RD$ 0.00</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Transferencias</div>
                            <div class="stat-value" id="montoTransferencias">RD$ 0.00</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <strong>Fecha Apertura:</strong> <span id="fechaApertura"></span>
                        <strong class="ml-4">Usuario:</strong> <span id="usuarioCaja"></span>
                    </div>
                </div>
            </div>

            <!-- Lista de Cajas -->
            <div class="card">
                <div class="card-header">
                    <h2>Historial de Cajas</h2>
                    <div class="filters">
                        <input type="date" id="fechaDesde" class="form-control form-control-sm">
                        <input type="date" id="fechaHasta" class="form-control form-control-sm">
                        <select id="filtroEstado" class="form-control form-control-sm">
                            <option value="">Todos</option>
                            <option value="abierta">Abierta</option>
                            <option value="cerrada">Cerrada</option>
                        </select>
                        <button class="btn btn-secondary btn-sm" onclick="filtrarCajas()">Filtrar</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha Apertura</th>
                                    <th>Fecha Cierre</th>
                                    <th>Monto Inicial</th>
                                    <th>Monto Final</th>
                                    <th>Estado</th>
                                    <th>Usuario</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaCajas">
                                <tr>
                                    <td colspan="8" class="text-center">Cargando...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Abrir Caja -->
    <div id="modalAbrirCaja" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Abrir Caja</h2>
                <button class="modal-close" onclick="cerrarModal('modalAbrirCaja')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formAbrirCaja">
                    <div class="form-group">
                        <label>Monto Inicial (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="montoInicialInput" required>
                    </div>
                    <div class="form-group">
                        <label>Observaciones</label>
                        <textarea class="form-control" id="observacionesApertura" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalAbrirCaja')">Cancelar</button>
                <button class="btn btn-primary" onclick="confirmarAbrirCaja()">Abrir Caja</button>
            </div>
        </div>
    </div>

    <!-- Modal Cerrar Caja -->
    <div id="modalCerrarCaja" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Cerrar Caja</h2>
                <button class="modal-close" onclick="cerrarModal('modalCerrarCaja')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formCerrarCaja">
                    <div class="form-group">
                        <label>Monto Final Efectivo (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="montoFinalEfectivo" required min="0">
                    </div>
                    <div class="form-group">
                        <label>Monto Cheques (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="montoChequesCierre" value="0" min="0">
                    </div>
                    <div class="form-group">
                        <label>Monto Transferencias (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="montoTransferenciasCierre" value="0" min="0">
                    </div>
                    <div class="form-group">
                        <label>Monto Tarjetas (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="montoTarjetasCierre" value="0" min="0">
                    </div>
                    <div class="form-group">
                        <label>Observaciones</label>
                        <textarea class="form-control" id="observacionesCierre" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalCerrarCaja')">Cancelar</button>
                <button class="btn btn-primary" onclick="confirmarCerrarCaja()">Cerrar Caja</button>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Caja -->
    <div id="modalDetalleCaja" class="modal" style="display: none;">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2>Detalle de Caja #<span id="detalleCajaId"></span></h2>
                <button class="modal-close" onclick="cerrarModal('modalDetalleCaja')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid grid-2">
                    <div>
                        <h3>Información General</h3>
                        <table class="table">
                            <tr>
                                <th>Fecha Apertura:</th>
                                <td id="detalleFechaApertura">-</td>
                            </tr>
                            <tr>
                                <th>Fecha Cierre:</th>
                                <td id="detalleFechaCierre">-</td>
                            </tr>
                            <tr>
                                <th>Estado:</th>
                                <td><span id="detalleEstado" class="badge">-</span></td>
                            </tr>
                            <tr>
                                <th>Usuario:</th>
                                <td id="detalleUsuario">-</td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h3>Montos</h3>
                        <table class="table">
                            <tr>
                                <th>Monto Inicial:</th>
                                <td id="detalleMontoInicial">-</td>
                            </tr>
                            <tr>
                                <th>Monto Final:</th>
                                <td id="detalleMontoFinal">-</td>
                            </tr>
                            <tr>
                                <th>Diferencia:</th>
                                <td id="detalleDiferencia">-</td>
                            </tr>
                            <tr>
                                <th>Efectivo:</th>
                                <td id="detalleMontoEfectivo">-</td>
                            </tr>
                            <tr>
                                <th>Cheques:</th>
                                <td id="detalleMontoCheques">-</td>
                            </tr>
                            <tr>
                                <th>Transferencias:</th>
                                <td id="detalleMontoTransferencias">-</td>
                            </tr>
                            <tr>
                                <th>Tarjetas:</th>
                                <td id="detalleMontoTarjetas">-</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <h3>Observaciones</h3>
                    <p id="detalleObservaciones">-</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalDetalleCaja')">Cerrar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/caja.js"></script>
</body>
</html>

