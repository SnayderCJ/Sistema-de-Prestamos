<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monedas - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="configuracion.html">Configuración</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="configuracion.html">⚙️ Configuración</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Monedas</h1>
                <button class="btn btn-primary" onclick="abrirModalMoneda()">Nueva Moneda</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Listado de Monedas</h2>
                </div>
                <div class="table-responsive">
                    <table class="table" id="tablaMonedas">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Símbolo</th>
                                <th>Tasa de Cambio</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="6" class="text-center">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Moneda -->
    <div class="modal" id="modalMoneda">
        <div class="modal-backdrop" onclick="cerrarModalMoneda()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 id="tituloModalMoneda">Nueva Moneda</h3>
                <button class="modal-close" onclick="cerrarModalMoneda()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formMoneda" onsubmit="guardarMoneda(event)">
                    <input type="hidden" id="monedaId">
                    
                    <div class="form-group">
                        <label>Código *</label>
                        <input type="text" class="form-control" id="codigoMoneda" maxlength="3" required>
                        <small>Ejemplo: DOP, USD, EUR</small>
                    </div>

                    <div class="form-group">
                        <label>Nombre *</label>
                        <input type="text" class="form-control" id="nombreMoneda" required>
                    </div>

                    <div class="form-group">
                        <label>Símbolo *</label>
                        <input type="text" class="form-control" id="simboloMoneda" required>
                        <small>Ejemplo: RD$, $, €</small>
                    </div>

                    <div class="form-group">
                        <label>Tasa de Cambio *</label>
                        <input type="number" class="form-control" id="tasaCambio" step="0.0001" required>
                        <small>Tasa respecto a la moneda base (DOP)</small>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModalMoneda()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/monedas.js"></script>
</body>
</html>

