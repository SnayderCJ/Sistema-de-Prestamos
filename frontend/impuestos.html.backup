<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Impuestos - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="configuracion.html">Configuración</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="configuracion.html">⚙️ Configuración</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Impuestos</h1>
                <button class="btn btn-primary" onclick="abrirModalImpuesto()">Nuevo Impuesto</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Listado de Impuestos</h2>
                </div>
                <div class="table-responsive">
                    <table class="table" id="tablaImpuestos">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Porcentaje</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5" class="text-center">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Impuesto -->
    <div class="modal" id="modalImpuesto">
        <div class="modal-backdrop" onclick="cerrarModalImpuesto()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 id="tituloModalImpuesto">Nuevo Impuesto</h3>
                <button class="modal-close" onclick="cerrarModalImpuesto()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formImpuesto" onsubmit="guardarImpuesto(event)">
                    <input type="hidden" id="impuestoId">
                    
                    <div class="form-group">
                        <label>Nombre *</label>
                        <input type="text" class="form-control" id="nombreImpuesto" required>
                    </div>

                    <div class="form-group">
                        <label>Tipo *</label>
                        <select class="form-control" id="tipoImpuesto" required>
                            <option value="">Seleccionar...</option>
                            <option value="itbis">ITBIS</option>
                            <option value="isc">ISC</option>
                            <option value="isr">ISR</option>
                            <option value="otros">Otros</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Porcentaje *</label>
                        <input type="number" class="form-control" id="porcentajeImpuesto" step="0.01" required>
                        <small>Porcentaje del impuesto (ej: 18 para ITBIS)</small>
                    </div>

                    <div class="form-group">
                        <label>Descripción</label>
                        <textarea class="form-control" id="descripcionImpuesto" rows="3"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModalImpuesto()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/impuestos.js"></script>
</body>
</html>

