<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garantes - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html">
                        <span class="icon">📊</span>
                        Dashboard
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html">
                        <span class="icon">💵</span>
                        Préstamos
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html">
                        <span class="icon">👥</span>
                        Clientes
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="garantes.html" class="active">
                        <span class="icon">🤝</span>
                        Garantes
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="page-header">
                <h1>Garantes</h1>
                <button class="btn btn-primary" onclick="abrirModalCrearGarante()">Nuevo Garante</button>
            </div>

            <!-- Filtros -->
            <div class="filters-bar">
                <input type="text" id="buscarGarante" class="form-control" placeholder="Buscar por nombre, cédula..." onkeyup="filtrarGarantes()">
                <select id="filtroEstado" class="form-control" onchange="cargarGarantes()">
                    <option value="">Todos los estados</option>
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>
            </div>

            <!-- Tabla de Garantes -->
            <div class="table-responsive">
                <table class="table" id="tablaGarantes">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Teléfono</th>
                            <th>Préstamos Garantizados</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center">
                                <div class="loading">
                                    <div class="loading-spinner"></div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination" id="paginacionGarantes"></div>
        </main>
    </div>

    <!-- Modal Crear/Editar Garante -->
    <div class="modal" id="modalGarante">
        <div class="modal-backdrop" onclick="cerrarModal('modalGarante')"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title" id="modalGaranteTitulo">Nuevo Garante</h3>
                <button class="modal-close" onclick="cerrarModal('modalGarante')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formGarante" onsubmit="guardarGarante(event)">
                    <input type="hidden" id="garanteId">
                    
                    <div class="form-group">
                        <label>Cédula *</label>
                        <input type="text" id="garanteCedula" class="form-control" required maxlength="11" onblur="validarCedulaGarante()">
                        <small class="text-danger" id="errorCedulaGarante" style="display:none;"></small>
                    </div>
                    
                    <div class="form-group">
                        <label>Nombre *</label>
                        <input type="text" id="garanteNombre" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Apellido *</label>
                        <input type="text" id="garanteApellido" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Teléfono</label>
                        <input type="text" id="garanteTelefono" class="form-control">
                    </div>
                    
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="garanteEmail" class="form-control">
                    </div>
                    
                    <div class="form-group">
                        <label>Dirección</label>
                        <textarea id="garanteDireccion" class="form-control" rows="3"></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label>Ocupación</label>
                        <input type="text" id="garanteOcupacion" class="form-control">
                    </div>
                    
                    <div class="form-group">
                        <label>Ingresos Mensuales</label>
                        <input type="number" id="garanteIngresos" class="form-control" step="0.01" min="0">
                    </div>
                    
                    <div class="form-group">
                        <label>Estado</label>
                        <select id="garanteEstado" class="form-control">
                            <option value="activo">Activo</option>
                            <option value="inactivo">Inactivo</option>
                        </select>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalGarante')">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Garante -->
    <div class="modal" id="modalDetalleGarante">
        <div class="modal-backdrop" onclick="cerrarModal('modalDetalleGarante')"></div>
        <div class="modal-dialog modal-lg">
            <div class="modal-header">
                <h3 class="modal-title">Detalle de Garante</h3>
                <button class="modal-close" onclick="cerrarModal('modalDetalleGarante')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid grid-2">
                    <div>
                        <h4>Información Personal</h4>
                        <table class="table">
                            <tr>
                                <th>Cédula:</th>
                                <td id="detalleGaranteCedula">-</td>
                            </tr>
                            <tr>
                                <th>Nombre:</th>
                                <td id="detalleGaranteNombre">-</td>
                            </tr>
                            <tr>
                                <th>Apellido:</th>
                                <td id="detalleGaranteApellido">-</td>
                            </tr>
                            <tr>
                                <th>Teléfono:</th>
                                <td id="detalleGaranteTelefono">-</td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td id="detalleGaranteEmail">-</td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h4>Información Adicional</h4>
                        <table class="table">
                            <tr>
                                <th>Dirección:</th>
                                <td id="detalleGaranteDireccion">-</td>
                            </tr>
                            <tr>
                                <th>Ocupación:</th>
                                <td id="detalleGaranteOcupacion">-</td>
                            </tr>
                            <tr>
                                <th>Ingresos:</th>
                                <td id="detalleGaranteIngresos">-</td>
                            </tr>
                            <tr>
                                <th>Estado:</th>
                                <td><span id="detalleGaranteEstado" class="badge">-</span></td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <div class="mt-3">
                    <h4>Préstamos Garantizados</h4>
                    <div id="prestamosGarantizados" class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Número</th>
                                    <th>Cliente</th>
                                    <th>Monto</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody id="tablaPrestamosGarantizados">
                                <tr><td colspan="4" class="text-center">Cargando...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="editarGaranteDesdeDetalle()">Editar</button>
                <button class="btn btn-secondary" onclick="cerrarModal('modalDetalleGarante')">Cerrar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/garantes.js"></script>
</body>
</html>

