<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Avanzado - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="dashboard-avanzado.html" class="active">Dashboard Avanzado</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
                <a href="rutas.html">Rutas</a>
                <a href="pagos.html">Pagos</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span>Juan Doe</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html">
                        <span class="icon">📊</span>
                        Dashboard
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="dashboard-avanzado.html" class="active">
                        <span class="icon">📈</span>
                        Dashboard Avanzado
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html">
                        <span class="icon">💵</span>
                        Préstamos
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html">
                        <span class="icon">👥</span>
                        Clientes
                    </a>
                </div>
                
                <div class="sidebar-menu-title">Operaciones</div>
                <div class="sidebar-menu-item">
                    <a href="rutas.html">
                        <span class="icon">🗺️</span>
                        Rutas
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="pagos.html">
                        <span class="icon">💳</span>
                        Pagos
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="dashboard-avanzado">
                <div class="dashboard-header">
                    <h1>Dashboard Avanzado</h1>
                    <div class="dashboard-filters">
                        <input type="date" id="fechaDesde" class="form-control" />
                        <input type="date" id="fechaHasta" class="form-control" />
                        <button class="btn btn-primary" onclick="cargarDashboardAvanzado()">Aplicar Filtros</button>
                        <button class="btn btn-secondary" onclick="exportarDashboard()">Exportar PDF</button>
                    </div>
                </div>

                <!-- Estadísticas Avanzadas -->
                <div class="dashboard-stats-advanced">
                    <div class="card">
                        <div class="card-stat">
                            <span class="card-stat-value" id="stat-total-prestamos">0</span>
                            <span class="card-stat-label">Total Préstamos</span>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-stat">
                            <span class="card-stat-value" id="stat-prestamos-activos">0</span>
                            <span class="card-stat-label">Préstamos Activos</span>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-stat">
                            <span class="card-stat-value" id="stat-monto-activos">RD$ 0</span>
                            <span class="card-stat-label">Monto Activos</span>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-stat">
                            <span class="card-stat-value" id="stat-tasa-recuperacion">0%</span>
                            <span class="card-stat-label">Tasa Recuperación</span>
                        </div>
                    </div>
                </div>

                <!-- Gráficos -->
                <div class="dashboard-charts">
                    <div class="chart-container">
                        <div class="card">
                            <div class="card-header">
                                <h3>Préstamos por Mes</h3>
                            </div>
                            <div class="card-body">
                                <canvas id="chartPrestamosMes"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="chart-container">
                        <div class="card">
                            <div class="card-header">
                                <h3>Cobros por Mes</h3>
                            </div>
                            <div class="card-body">
                                <canvas id="chartCobrosMes"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="chart-container">
                        <div class="card">
                            <div class="card-header">
                                <h3>Distribución por Estado</h3>
                            </div>
                            <div class="card-body">
                                <canvas id="chartDistribucionEstado"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Clientes -->
                <div class="dashboard-section">
                    <div class="dashboard-section-title">
                        <h2>Top 10 Clientes</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table" id="tablaTopClientes">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Cédula</th>
                                    <th>Cliente</th>
                                    <th>Total Préstamos</th>
                                    <th>Monto Total</th>
                                    <th>Monto Pagado</th>
                                    <th>Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="7" class="text-center">
                                        <div class="loading">
                                            <div class="loading-spinner"></div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tendencias -->
                <div class="dashboard-section">
                    <div class="dashboard-section-title">
                        <h2>Tendencias</h2>
                    </div>
                    <div class="tendencias-grid">
                        <div class="card">
                            <div class="card-header">
                                <h4>Variación de Préstamos</h4>
                            </div>
                            <div class="card-body">
                                <div class="tendencia-item">
                                    <span class="tendencia-label">Mes Actual:</span>
                                    <span class="tendencia-value" id="tendencia-cantidad-actual">0</span>
                                </div>
                                <div class="tendencia-item">
                                    <span class="tendencia-label">Mes Anterior:</span>
                                    <span class="tendencia-value" id="tendencia-cantidad-anterior">0</span>
                                </div>
                                <div class="tendencia-item">
                                    <span class="tendencia-label">Variación:</span>
                                    <span class="tendencia-value" id="tendencia-cantidad-variacion">0%</span>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header">
                                <h4>Variación de Monto</h4>
                            </div>
                            <div class="card-body">
                                <div class="tendencia-item">
                                    <span class="tendencia-label">Mes Actual:</span>
                                    <span class="tendencia-value" id="tendencia-monto-actual">RD$ 0</span>
                                </div>
                                <div class="tendencia-item">
                                    <span class="tendencia-label">Mes Anterior:</span>
                                    <span class="tendencia-value" id="tendencia-monto-anterior">RD$ 0</span>
                                </div>
                                <div class="tendencia-item">
                                    <span class="tendencia-label">Variación:</span>
                                    <span class="tendencia-value" id="tendencia-monto-variacion">0%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/dashboard-avanzado.js"></script>
</body>
</html>

