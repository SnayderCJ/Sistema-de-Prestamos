<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultas - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="clientes.html">Clientes</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html">👥 Clientes</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Consultas de Clientes</h1>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Realizar Consulta</h2>
                </div>
                <div class="card-body">
                    <form id="formConsulta" onsubmit="realizarConsulta(event)">
                        <div class="form-group">
                            <label>Tipo de Consulta *</label>
                            <select class="form-control" id="tipoConsulta" required>
                                <option value="">Seleccionar...</option>
                                <option value="cedula">Por Cédula</option>
                                <option value="nombre">Por Nombre</option>
                                <option value="prestamo">Por Préstamo</option>
                                <option value="telefono">Por Teléfono</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Valor de Búsqueda *</label>
                            <input type="text" class="form-control" id="valorConsulta" required>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Consultar</button>
                            <button type="button" class="btn btn-secondary" onclick="limpiarConsulta()">Limpiar</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card" id="resultadoConsulta" style="display: none;">
                <div class="card-header">
                    <h2>Resultados de la Consulta</h2>
                </div>
                <div class="card-body" id="contenidoResultado">
                </div>
            </div>
        </main>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/consultas.js"></script>
</body>
</html>

