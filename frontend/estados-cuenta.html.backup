<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estados de Cuenta - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html">💵 Préstamos</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Estados de Cuenta</h1>
                <button class="btn btn-primary" onclick="generarEstadoCuenta()">Generar Estado</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Filtros</h2>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Cliente</label>
                            <select class="form-control" id="filtroCliente">
                                <option value="">Todos</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Préstamo</label>
                            <input type="text" class="form-control" id="filtroPrestamo" placeholder="Número de préstamo">
                        </div>
                        <div class="form-group">
                            <label>Fecha Desde</label>
                            <input type="date" class="form-control" id="filtroFechaDesde">
                        </div>
                        <div class="form-group">
                            <label>Fecha Hasta</label>
                            <input type="date" class="form-control" id="filtroFechaHasta">
                        </div>
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button class="btn btn-primary" onclick="cargarEstadosCuenta()">Buscar</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Estados de Cuenta Generados</h2>
                </div>
                <div class="table-responsive">
                    <table class="table" id="tablaEstadosCuenta">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Cliente</th>
                                <th>Préstamo</th>
                                <th>Fecha Generación</th>
                                <th>Período</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="6" class="text-center">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Generar Estado -->
    <div class="modal" id="modalEstadoCuenta">
        <div class="modal-backdrop" onclick="cerrarModalEstado()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Generar Estado de Cuenta</h3>
                <button class="modal-close" onclick="cerrarModalEstado()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formEstadoCuenta" onsubmit="crearEstadoCuenta(event)">
                    <div class="form-group">
                        <label>Cliente *</label>
                        <select class="form-control" id="clienteEstado" required>
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Préstamo *</label>
                        <select class="form-control" id="prestamoEstado" required>
                            <option value="">Seleccionar cliente primero</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Fecha Desde *</label>
                            <input type="date" class="form-control" id="fechaDesdeEstado" required>
                        </div>
                        <div class="form-group">
                            <label>Fecha Hasta *</label>
                            <input type="date" class="form-control" id="fechaHastaEstado" required>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModalEstado()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Generar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/estados-cuenta.js"></script>
</body>
</html>

