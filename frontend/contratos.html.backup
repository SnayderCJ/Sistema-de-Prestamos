<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contratos - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="prestamos.html">Préstamos</a>
                <a href="clientes.html">Clientes</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html">
                        <span class="icon">📊</span>
                        Dashboard
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="prestamos.html">
                        <span class="icon">💵</span>
                        Préstamos
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="clientes.html">
                        <span class="icon">👥</span>
                        Clientes
                    </a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="contratos.html" class="active">
                        <span class="icon">📄</span>
                        Contratos
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="page-header">
                <h1>Contratos</h1>
                <button class="btn btn-primary" onclick="abrirModalCrearContrato()">Nuevo Contrato</button>
            </div>

            <!-- Filtros -->
            <div class="filters-bar">
                <input type="text" id="buscarContrato" class="form-control" placeholder="Buscar por número, cliente..." onkeyup="filtrarContratos()">
                <select id="filtroEstado" class="form-control" onchange="cargarContratos()">
                    <option value="">Todos los estados</option>
                    <option value="vigente">Vigente</option>
                    <option value="vencido">Vencido</option>
                    <option value="cancelado">Cancelado</option>
                </select>
                <input type="date" id="filtroFechaDesde" class="form-control" onchange="cargarContratos()">
                <input type="date" id="filtroFechaHasta" class="form-control" onchange="cargarContratos()">
            </div>

            <!-- Tabla de Contratos -->
            <div class="table-responsive">
                <table class="table" id="tablaContratos">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Préstamo</th>
                            <th>Cliente</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Vencimiento</th>
                            <th>Monto</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center">
                                <div class="loading">
                                    <div class="loading-spinner"></div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination" id="paginacionContratos"></div>
        </main>
    </div>

    <!-- Modal Crear/Editar Contrato -->
    <div class="modal" id="modalContrato">
        <div class="modal-backdrop" onclick="cerrarModal('modalContrato')"></div>
        <div class="modal-dialog modal-lg">
            <div class="modal-header">
                <h3 class="modal-title" id="modalContratoTitulo">Nuevo Contrato</h3>
                <button class="modal-close" onclick="cerrarModal('modalContrato')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formContrato" onsubmit="guardarContrato(event)">
                    <input type="hidden" id="contratoId">
                    
                    <div class="form-group">
                        <label>Préstamo *</label>
                        <select id="contratoPrestamoId" class="form-control" required onchange="cargarDatosPrestamo()">
                            <option value="">Seleccionar préstamo</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label>Fecha Inicio *</label>
                        <input type="date" id="contratoFechaInicio" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Fecha Vencimiento *</label>
                        <input type="date" id="contratoFechaVencimiento" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Tipo de Contrato *</label>
                        <select id="contratoTipo" class="form-control" required>
                            <option value="prestamo">Préstamo</option>
                            <option value="garantia">Garantía</option>
                            <option value="hipoteca">Hipoteca</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label>Descripción</label>
                        <textarea id="contratoDescripcion" class="form-control" rows="4"></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label>Monto del Contrato</label>
                        <input type="number" id="contratoMonto" class="form-control" step="0.01" min="0" readonly>
                    </div>
                    
                    <div class="form-group">
                        <label>Estado</label>
                        <select id="contratoEstado" class="form-control">
                            <option value="vigente">Vigente</option>
                            <option value="vencido">Vencido</option>
                            <option value="cancelado">Cancelado</option>
                        </select>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalContrato')">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Contrato -->
    <div class="modal" id="modalDetalleContrato">
        <div class="modal-backdrop" onclick="cerrarModal('modalDetalleContrato')"></div>
        <div class="modal-dialog modal-lg">
            <div class="modal-header">
                <h3 class="modal-title">Detalle de Contrato</h3>
                <button class="modal-close" onclick="cerrarModal('modalDetalleContrato')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid grid-2">
                    <div>
                        <h4>Información del Contrato</h4>
                        <table class="table">
                            <tr>
                                <th>Número:</th>
                                <td id="detalleContratoNumero">-</td>
                            </tr>
                            <tr>
                                <th>Préstamo:</th>
                                <td id="detalleContratoPrestamo">-</td>
                            </tr>
                            <tr>
                                <th>Cliente:</th>
                                <td id="detalleContratoCliente">-</td>
                            </tr>
                            <tr>
                                <th>Tipo:</th>
                                <td id="detalleContratoTipo">-</td>
                            </tr>
                            <tr>
                                <th>Estado:</th>
                                <td><span id="detalleContratoEstado" class="badge">-</span></td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h4>Fechas y Montos</h4>
                        <table class="table">
                            <tr>
                                <th>Fecha Inicio:</th>
                                <td id="detalleContratoFechaInicio">-</td>
                            </tr>
                            <tr>
                                <th>Fecha Vencimiento:</th>
                                <td id="detalleContratoFechaVencimiento">-</td>
                            </tr>
                            <tr>
                                <th>Monto:</th>
                                <td id="detalleContratoMonto">-</td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <div class="mt-3">
                    <h4>Descripción</h4>
                    <p id="detalleContratoDescripcion">-</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="imprimirContrato()">Imprimir</button>
                <button class="btn btn-secondary" onclick="cerrarModal('modalDetalleContrato')">Cerrar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/contratos.js"></script>
</body>
</html>

