{
  "name": "imaxprestamos-frontend",
  "version": "1.0.0",
  "description": "ImaxPrestamos - Frontend Web con SASS",
  "scripts": {
    "sass:watch": "sass src/scss:public/css --watch --style=expanded",
    "sass:build": "sass src/scss:public/css --style=compressed",
    "js:copy": "cpx \"src/js/**/*\" public/js",
    "js:watch": "cpx \"src/js/**/*\" public/js --watch",
    "assets:copy": "cpx \"src/assets/**/*\" public/img",
    "assets:watch": "cpx \"src/assets/**/*\" public/img --watch",
    "pages:copy": "cpx \"public/views/pages/*.html\" public/",
    "pages:watch": "cpx \"public/views/pages/*.html\" public/ --watch",
    "serve": "live-server public --port=3000 --open=/login.html",
    "dev": "npm-run-all --parallel sass:watch js:watch assets:watch pages:watch serve",
    "build": "npm-run-all js:copy assets:copy pages:copy sass:build"
  },
  "keywords": [
    "prestamos",
    "erp",
    "sass"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cpx": "^1.5.0",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.69.5"
  }
}