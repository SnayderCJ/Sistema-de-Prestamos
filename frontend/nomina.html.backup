<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nómina - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="header-logo">
                💰 ImaxPrestamos
            </div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="nomina.html" class="active">Nómina</a>
            </nav>
            <div class="header-user">
                <div class="header-user-info">
                    <div class="avatar">JD</div>
                    <span id="userName">Usuario</span>
                </div>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-title">Principal</div>
                <div class="sidebar-menu-item">
                    <a href="index.html"><span class="icon">📊</span> Dashboard</a>
                </div>
                
                <div class="sidebar-menu-title">Recursos Humanos</div>
                <div class="sidebar-menu-item">
                    <a href="nomina.html" class="active"><span class="icon">💰</span> Nómina</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="empleados.html"><span class="icon">👥</span> Empleados</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="bonos-cobradores.html"><span class="icon">🎁</span> Bonos</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Nómina</h1>
                <button class="btn btn-primary" onclick="procesarNomina()">
                    <span class="icon">➕</span> Procesar Nómina
                </button>
            </div>

            <!-- Filtros -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="filters">
                        <select id="filtroEmpleado" class="form-control form-control-sm">
                            <option value="">Todos los empleados</option>
                        </select>
                        <input type="text" id="filtroPeriodo" class="form-control form-control-sm" placeholder="Período (YYYY-MM)">
                        <select id="filtroEstado" class="form-control form-control-sm">
                            <option value="">Todos</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="pagado">Pagado</option>
                        </select>
                        <button class="btn btn-secondary btn-sm" onclick="filtrarNomina()">Filtrar</button>
                    </div>
                </div>
            </div>

            <!-- Lista de Nómina -->
            <div class="card">
                <div class="card-header">
                    <h2>Historial de Nómina</h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Empleado</th>
                                    <th>Período</th>
                                    <th>Fecha Pago</th>
                                    <th>Salario Base</th>
                                    <th>Ingresos</th>
                                    <th>Descuentos</th>
                                    <th>Neto a Pagar</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaNomina">
                                <tr>
                                    <td colspan="9" class="text-center">Cargando...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Procesar Nómina -->
    <div id="modalNomina" class="modal" style="display: none;">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2>Procesar Nómina</h2>
                <button class="modal-close" onclick="cerrarModal('modalNomina')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formNomina">
                    <div class="form-group">
                        <label>Empleado *</label>
                        <select class="form-control" id="empleadoId" required onchange="calcularNomina()">
                            <option value="">Seleccionar empleado</option>
                        </select>
                    </div>
                    <div class="grid grid-2">
                        <div class="form-group">
                            <label>Período *</label>
                            <input type="text" class="form-control" id="periodo" required placeholder="YYYY-MM" pattern="\d{4}-\d{2}">
                        </div>
                        <div class="form-group">
                            <label>Fecha de Pago *</label>
                            <input type="date" class="form-control" id="fechaPago" required>
                        </div>
                    </div>
                    
                    <h3 class="mt-4 mb-3">Ingresos</h3>
                    <div class="grid grid-2">
                        <div class="form-group">
                            <label>Horas Extras</label>
                            <input type="number" step="0.01" class="form-control" id="horasExtras" value="0" onchange="calcularNomina()">
                        </div>
                        <div class="form-group">
                            <label>Bonos (RD$)</label>
                            <input type="number" step="0.01" class="form-control" id="bonos" value="0" onchange="calcularNomina()">
                        </div>
                        <div class="form-group">
                            <label>Comisiones (RD$)</label>
                            <input type="number" step="0.01" class="form-control" id="comisiones" value="0" onchange="calcularNomina()">
                        </div>
                        <div class="form-group">
                            <label>Otros Ingresos (RD$)</label>
                            <input type="number" step="0.01" class="form-control" id="otrosIngresos" value="0" onchange="calcularNomina()">
                        </div>
                    </div>
                    
                    <h3 class="mt-4 mb-3">Descuentos</h3>
                    <div class="form-group">
                        <label>Otros Descuentos (RD$)</label>
                        <input type="number" step="0.01" class="form-control" id="otrosDescuentos" value="0" onchange="calcularNomina()">
                    </div>
                    
                    <div class="card mt-4">
                        <div class="card-header">
                            <h4>Resumen de Cálculo</h4>
                        </div>
                        <div class="card-body">
                            <div class="grid grid-2">
                                <div>
                                    <strong>Salario Base:</strong> <span id="resumenSalarioBase">RD$ 0.00</span><br>
                                    <strong>Total Ingresos:</strong> <span id="resumenTotalIngresos">RD$ 0.00</span>
                                </div>
                                <div>
                                    <strong>Total Descuentos:</strong> <span id="resumenTotalDescuentos">RD$ 0.00</span><br>
                                    <strong>Neto a Pagar:</strong> <span id="resumenNetoPagar" class="text-success" style="font-size: 1.2em;">RD$ 0.00</span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <strong>Desglose:</strong><br>
                                    AFP: <span id="resumenAFP">RD$ 0.00</span> | 
                                    ARS: <span id="resumenARS">RD$ 0.00</span> | 
                                    ISR: <span id="resumenISR">RD$ 0.00</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalNomina')">Cancelar</button>
                <button class="btn btn-primary" onclick="confirmarProcesarNomina()">Procesar Nómina</button>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Nómina -->
    <div id="modalDetalleNomina" class="modal" style="display: none;">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2>Detalle de Nómina #<span id="detalleNominaId"></span></h2>
                <button class="modal-close" onclick="cerrarModal('modalDetalleNomina')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid grid-2">
                    <div>
                        <h3>Información General</h3>
                        <table class="table">
                            <tr>
                                <th>ID:</th>
                                <td id="detalleNominaId">-</td>
                            </tr>
                            <tr>
                                <th>Empleado:</th>
                                <td id="detalleNominaEmpleado">-</td>
                            </tr>
                            <tr>
                                <th>Período:</th>
                                <td id="detalleNominaPeriodo">-</td>
                            </tr>
                            <tr>
                                <th>Fecha Procesamiento:</th>
                                <td id="detalleNominaFecha">-</td>
                            </tr>
                            <tr>
                                <th>Usuario:</th>
                                <td id="detalleNominaUsuario">-</td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h3>Ingresos</h3>
                        <table class="table">
                            <tr>
                                <th>Salario Base:</th>
                                <td id="detalleNominaSalarioBase">-</td>
                            </tr>
                            <tr>
                                <th>Horas Extras:</th>
                                <td id="detalleNominaHorasExtras">-</td>
                            </tr>
                            <tr>
                                <th>Monto Horas Extras:</th>
                                <td id="detalleNominaMontoHorasExtras">-</td>
                            </tr>
                            <tr>
                                <th>Bonificaciones:</th>
                                <td id="detalleNominaBonificaciones">-</td>
                            </tr>
                            <tr>
                                <th><strong>Total Bruto:</strong></th>
                                <td><strong id="detalleNominaTotalBruto">-</strong></td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <h3>Descuentos</h3>
                    <table class="table">
                        <tr>
                            <th>AFP:</th>
                            <td id="detalleNominaAFP">-</td>
                        </tr>
                        <tr>
                            <th>ARS:</th>
                            <td id="detalleNominaARS">-</td>
                        </tr>
                        <tr>
                            <th>ISR:</th>
                            <td id="detalleNominaISR">-</td>
                        </tr>
                        <tr>
                            <th>Otros Descuentos:</th>
                            <td id="detalleNominaDescuentos">-</td>
                        </tr>
                        <tr>
                            <th><strong>Total Descuentos:</strong></th>
                            <td><strong id="detalleNominaTotalDescuentos">-</strong></td>
                        </tr>
                    </table>
                </div>
                <div class="mt-3">
                    <h3>Resumen</h3>
                    <table class="table">
                        <tr>
                            <th>Total Bruto:</th>
                            <td id="detalleNominaTotalBruto">-</td>
                        </tr>
                        <tr>
                            <th>Total Descuentos:</th>
                            <td id="detalleNominaTotalDescuentos">-</td>
                        </tr>
                        <tr>
                            <th><strong>Total Neto a Pagar:</strong></th>
                            <td><strong class="text-success" id="detalleNominaTotalNeto">-</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal('modalDetalleNomina')">Cerrar</button>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/nomina.js"></script>
</body>
</html>

