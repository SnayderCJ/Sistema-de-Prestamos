<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bonos de Cobradores - ImaxPrestamos</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="header-logo">💰 ImaxPrestamos</div>
            <nav class="header-nav">
                <a href="index.html">Dashboard</a>
                <a href="nomina.html">Nómina</a>
            </nav>
            <div class="header-user">
                <button class="btn btn-ghost btn-sm" onclick="logout()">Salir</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <nav class="sidebar-menu">
                <div class="sidebar-menu-item">
                    <a href="index.html">📊 Dashboard</a>
                </div>
                <div class="sidebar-menu-item">
                    <a href="nomina.html">💰 Nómina</a>
                </div>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Bonos de Cobradores</h1>
                <button class="btn btn-primary" onclick="abrirModalBono()">Nuevo Bono</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Filtros</h2>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Cobrador</label>
                            <select class="form-control" id="filtroCobrador">
                                <option value="">Todos</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Mes</label>
                            <input type="month" class="form-control" id="filtroMes">
                        </div>
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button class="btn btn-primary" onclick="cargarBonos()">Buscar</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Bonos Registrados</h2>
                </div>
                <div class="table-responsive">
                    <table class="table" id="tablaBonos">
                        <thead>
                            <tr>
                                <th>Cobrador</th>
                                <th>Mes</th>
                                <th>Monto Cobrado</th>
                                <th>Porcentaje</th>
                                <th>Bono</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="7" class="text-center">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Bono -->
    <div class="modal" id="modalBono">
        <div class="modal-backdrop" onclick="cerrarModalBono()"></div>
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Nuevo Bono de Cobrador</h3>
                <button class="modal-close" onclick="cerrarModalBono()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="formBono" onsubmit="crearBono(event)">
                    <div class="form-group">
                        <label>Cobrador *</label>
                        <select class="form-control" id="cobradorBono" required>
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Mes *</label>
                        <input type="month" class="form-control" id="mesBono" required>
                    </div>

                    <div class="form-group">
                        <label>Monto Cobrado *</label>
                        <input type="number" class="form-control" id="montoCobrado" step="0.01" required>
                    </div>

                    <div class="form-group">
                        <label>Porcentaje de Bono (%) *</label>
                        <input type="number" class="form-control" id="porcentajeBono" step="0.01" required>
                    </div>

                    <div class="form-group">
                        <label>Bono Calculado</label>
                        <input type="text" class="form-control" id="bonoCalculado" readonly>
                    </div>

                    <div class="form-group">
                        <label>Observaciones</label>
                        <textarea class="form-control" id="observacionesBono" rows="3"></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="cerrarModalBono()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/app.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/bonos-cobradores.js"></script>
</body>
</html>

